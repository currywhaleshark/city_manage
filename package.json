{
  "name": "our-neighborhood-mayor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "verify:report": "tsx tests/report.ts",
    "verify:experiments": "tsx tests/experiments-report.ts",
    "verify:capacity": "tsx tests/capacity-report.ts",
    "verify:performance": "playwright test --config playwright.performance.config.ts",
    "verify:production": "tsx tests/production-smoke.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.184.1",
    "tsx": "^4.20.0",
    "typescript": "^5.4.5",
    "vite": "^8.3.4"
  }
}
